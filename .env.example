# --- Database (Docker Compose) ---
POSTGRES_USER=library
POSTGRES_PASSWORD=changeme
POSTGRES_DB=library
DATABASE_URL=postgresql://library:changeme@localhost:5434/library

# --- Anthropic API ---
# Required for Tier 1 (Haiku) and Tier 2 (Sonnet) generation
ANTHROPIC_API_KEY=sk-ant-...

# --- Budget enforcement ---
# Hard daily cap (USD). Pipeline pauses when reached.
DAILY_BUDGET_USD=20

# --- Pipeline paths ---
WIKIDATA_DUMP_PATH=./dumps/latest-all.json.bz2
WIKIPEDIA_DUMP_PATH=./dumps/enwiki-latest-pages-articles-multistream.xml.bz2

# --- Wikimedia compliance ---
# Per Wikimedia API policy, requests MUST include a descriptive User-Agent
# with project identifier and a contact email/URL.
WIKIMEDIA_USER_AGENT=LibraryOfAlexandria/0.1 (local development; contact: andrestran@icloud.com)
