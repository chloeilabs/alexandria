# --- Database (Docker Compose local) ---
POSTGRES_USER=library
POSTGRES_PASSWORD=changeme
POSTGRES_DB=library
DATABASE_URL=postgresql://library:changeme@localhost:5434/library

# --- AI Gateway (Vercel) ---
# Get a key at: https://vercel.com/[team]/~/ai-gateway/api-keys
# Default models: google/gemini-3.5-flash + voyage/voyage-4-large.
AI_GATEWAY_API_KEY=

# --- Budget enforcement ---
# Hard monthly cap (USD). Pipeline pauses on every Gateway call until
# new window opens. Daily and hourly windows default to MONTHLY/30 and
# MONTHLY/300 respectively if unset.
MONTHLY_BUDGET_USD=100

# --- Admin + cron ---
# Bearer token for /admin/* and /api/admin/*.
ADMIN_TOKEN=
# Bearer token for /api/cron/refresh-featured. Set via `printf "%s"`
# (NOT echo) — Vercel rejects env values with trailing whitespace.
CRON_SECRET=
